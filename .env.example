# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Direct Postgres connection string (used to apply db/schema.sql)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# YouTube Data API (Phase 1)
YOUTUBE_API_KEY=

# IMSLP (Phase 2) — inert until enabled. Confirm IMSLP's terms of use first, then
# set to 1/true. No API key needed (public MediaWiki API).
IMSLP_ENABLED=

# MuseScore (Phase 3) via Google Custom Search — inert until both are set.
# GOOGLE_CSE_ID: Programmable Search Engine id (cx), engine restricted to musescore.com.
# GOOGLE_CSE_KEY: Google Cloud API key with the "Custom Search API" enabled.
# Free tier is 100 queries/day, so results are cached per query.
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
