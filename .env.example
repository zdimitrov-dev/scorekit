# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Direct Postgres connection string (used to apply db/schema.sql)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# YouTube Data API (Phase 1)
YOUTUBE_API_KEY=

# IMSLP (Phase 2) — inert until enabled. Confirm IMSLP's terms of use first, then
# set to 1/true. No API key needed (public MediaWiki API).
IMSLP_ENABLED=

# Google Custom Search for MuseScore (Phase 3)
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
